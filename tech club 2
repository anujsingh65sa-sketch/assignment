:root {
    --primary: #123c69;
    --secondary: #2a9d8f;
    --background: #f0f5fa;
    --text: #222222;
    --white: #ffffff;
    --spacing: 20px;
}

/* Universal selector */
* {
    box-sizing: border-box;
    margin: 0;
    padding: 0;
}

/* Element selector */
body {
    font-family: 'Poppins', sans-serif;
    background-color: var(--background);
    color: var(--text);
    font-size: 16px;
    line-height: 1.6;
}

h1 {
    font-size: 32px;
}

/* Header */
header {
    background-color: var(--primary);
    color: var(--white);
    text-align: center;
    padding: var(--spacing);
}

nav {
    margin-top: 10px;
}

nav a {
    color: var(--white);
    text-decoration: none;
    margin: 10px;
    font-weight: 600;
}

nav a:hover {
    color: #ffd166;
}

/* ID selector */
#hero {
    background-color: var(--secondary);
    color: var(--white);
    text-align: center;
    padding: 50px 20px;
}

#hero h2 {
    font-size: 30px;
    margin-bottom: 10px;
}

/* Class selector */
.card {
    background-color: var(--white);
    margin: var(--spacing);
    padding: var(--spacing);
    border-radius: 12px;
    box-shadow: 0 3px 10px #00000015;
}

.card h2 {
    color: var(--primary);
    margin-bottom: 12px;
}

.btn {
    display: inline-block;
    background-color: var(--primary);
    color: var(--white);
    text-decoration: none;
    padding: 10px 20px;
    margin-top: 15px;
    border-radius: 6px;
}

.btn:hover {
    background-color: #0b2545;
}

table {
    width: 100%;
    border-collapse: collapse;
    margin-top: 15px;
}

th, td {
    border: 1px solid #dddddd;
    padding: 12px;
    text-align: left;
}

th {
    background-color: var(--primary);
    color: var(--white);
}

footer {
    background-color: var(--primary);
    color: var(--white);
    text-align: center;
    padding: 15px;
}
</html>
