<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="description" content="Tech Club Events and Student Registration">
    <title>Tech Club</title>

    <link rel="icon" href="favicon.ico">
</head>
<body>

    <header>
        <h1>Welcome to Tech Club</h1>

        <nav>
            <a href="index.html">Home</a> |
            <a href="about.html">About</a> |
            <a href="register.html">Register</a> |
            <a href="contact.html">Contact</a>
        </nav>
    </header>

    <hr>

    <main>
        <h2>About Our Tech Club</h2>
        <p>Our Tech Club helps students learn coding and technology.</p>

        <h2>Upcoming Events</h2>

        <table border="1">
            <thead>
                <tr>
                    <th>Event Name</th>
                    <th>Date</th>
                    <th>Time</th>
                </tr>
            </thead>

            <tbody>
                <tr>
                    <td>Coding Competition</td>
                    <td>10 November 2026</td>
                    <td>10 AM</td>
                </tr>
                <tr>
                    <td>Web Development</td>
                    <td>15 November 2026</td>
                    <td>11 AM</td>
                </tr>
                <tr>
                    <td>AI Workshop</td>
                    <td>20 November 2026</td>
                    <td>12 PM</td>
                </tr>
            </tbody>

            <tfoot>
                <tr>
                    <td colspan="3">Total Events: 3</td>
                </tr>
            </tfoot>
        </table>

        <h2>Student Registration Form</h2>

        <form action="#" method="post">

            <label for="name">Full Name:</label>
            <input type="text" id="name" name="name" required>
            <br><br>

            <label for="email">Email:</label>
            <input type="email" id="email" name="email" required>
            <br><br>

            <label for="password">Password:</label>
            <input type="password" id="password" name="password" required>
            <br><br>

            <label for="date">Date of Birth:</label>
            <input type="date" id="date" name="date">
            <br><br>

            <label for="phone">Phone:</label>
            <input type="tel" id="phone" name="phone">
            <br><br>

            <p>Gender:</p>
            <input type="radio" id="male" name="gender" value="Male">
            <label for="male">Male</label>

            <input type="radio" id="female" name="gender" value="Female">
            <label for="female">Female</label>
            <br><br>

            <p>Choose Your Interests:</p>
            <input type="checkbox" id="coding" name="interest" value="Coding">
            <label for="coding">Coding</label>

            <input type="checkbox" id="web" name="interest" value="Web Development">
            <label for="web">Web Development</label>

            <input type="checkbox" id="ai" name="interest" value="AI">
            <label for="ai">AI</label>
            <br><br>

            <label for="event">Select Event:</label>
            <select id="event" name="event">
                <option value="Coding">Coding Competition</option>
                <option value="Web">Web Development</option>
                <option value="AI">AI Workshop</option>
            </select>
            <br><br>

            <label for="message">Message:</label>
            <br>
            <textarea id="message" name="message" rows="4" cols="30"></textarea>
            <br><br>

            <input type="submit" value="Register Now">
            <input type="reset" value="Clear Form">

        </form>
    </main>

    <hr>

    <footer>
        <p>© 2026 Tech Club | All Rights Reserved</p>
        <p>Email: techclub@example.com</p>
    </footer>

</body>
</html>
